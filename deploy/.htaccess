RewriteEngine On
# https + без www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://usatravel.ae%{REQUEST_URI} [L,R=301]

# служебные файлы закрыты
<FilesMatch "^(config\.php|leads\.log)$">
  Require all denied
</FilesMatch>

AddDefaultCharset UTF-8
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
