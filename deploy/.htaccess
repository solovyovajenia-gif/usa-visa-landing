RewriteEngine On
# https + без www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://usatravel.ae%{REQUEST_URI} [L,R=301]

# служебные файлы закрыты
<FilesMatch "^(config\.php|telegram\.php|leads\.log|\.kommo_fields\.json)$">
  Require all denied
</FilesMatch>

AddDefaultCharset UTF-8

# HTML всегда свежий — чтобы правки были видны сразу
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
